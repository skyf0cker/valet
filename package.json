{
  "name": "valet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sidecar/tsconfig.json",
    "build:sidecar": "bun -e 'import { chmodSync, copyFileSync, mkdirSync, rmSync } from \"node:fs\"; rmSync(\"resources/darwin-arm64/bin\", { recursive: true, force: true }); mkdirSync(\"resources/darwin-arm64/bin\", { recursive: true }); copyFileSync(process.execPath, \"resources/darwin-arm64/bin/valet-bun\"); chmodSync(\"resources/darwin-arm64/bin/valet-bun\", 0o755);' && bun build sidecar/src/main.ts --target=bun --outfile resources/darwin-arm64/bin/valet-agent.js",
    "test:sidecar": "bun test sidecar/src/__tests__"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "mygo-runtime": "^0.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mygo-cli": "^0.9.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7",
    "vite": "^8"
  }
}
